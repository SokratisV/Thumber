# BigWigsMods packager config. The repo root *is* the addon, so the package is
# built from here and named "Thumber" (the folder players extract into AddOns).
package-as: Thumber

# We bundle our libraries in Libs/ rather than pulling them as externals, so no
# externals block and no separate "nolib" zip.
enable-nolib-creation: no

# Repo-meta files that shouldn't ship inside the addon zip.
ignore:
  - .github
  - .gitattributes
  - .gitignore
  - .pkgmeta
